	keywords = {ChatGPT, Real-time, Sign Language Translation, Sign Spotting},
	pages = {1--6},
	file = {Full Text PDF:C\:\\Users\\senak\\Zotero\\storage\\7ER5DRC3\\Mercanoglu Sincan ve Bowden - 2025 - Spotter+GPT Turning Sign Spottings into Sentences with LLMs.pdf:application/pdf},
