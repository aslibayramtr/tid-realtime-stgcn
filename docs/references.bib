@inproceedings{b_comprehensive_2026,
	address = {Bengaluru, India},
	title = {Comprehensive {Comparative} {Study} on {Sign} {Language} {Translation} {Systems}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-5336-4},
	url = {https://ieeexplore.ieee.org/document/11603203/},
	doi = {10.1109/ICEMCSI67638.2026.11603203},
	abstract = {Sign Language Recognition and translation system is a useful technology for society aims to reduce the communication gap between deaf or hard-of-hearing individuals and the hearing population. It is more helpful for the empowering of deaf community and also works together with common people. This paper focuses on comparative study of various recognition and translation techniques. The survey focused on Vision-based, Skeleton-based, Wearable sensorbased, and Hybrid Deep Learning model techniques currently suggested by most researchers. Each work is analyzed in terms of algorithmic methodology, data requirements, computational complexity, accuracy, advantages, and limitations. Vision-based methods offer simplicity and cost-effectiveness but the accuracy depends on the quality of image or videos of the gestures. Skeleton-based method provides strong gesture representation and more accurate for dynamic movements; however, requires advanced tools or hardware. Wearable sensor-based methods helpful for accurate gesture recognition independent of environmental conditions; however, they also require advanced hardware’s and user dependency. This is not a budget friendly method. Hybrid Deep Learning architecture is an integration of vision, skeleton, and sensor-based technologies. It helps to translate both static and dynamic gestures. The review focused on comparing different SLR techniques, by considering each methods strength and weaknesses, and finally concludes Hybrid Deep Learning as the robust technique for sign language translation models. This comparative analysis helps researchers and application developers for selecting suitable technologies for practical applications and contributes the development of communication technologies.},
	language = {en},
	urldate = {2026-10-16},
	booktitle = {2026 {International} {Conference} on {Emerging} {Trends} in {Mobile} {Computing} and {Sustainable} {Informatics} ({ICEMCSI})},
	publisher = {IEEE},
	author = {B, Shijina and B, Ben Sujitha},
	month = jun,
	year = {2026},
	pages = {1--6},
	file = {PDF:C\:\\Users\\senak\\Zotero\\storage\\FFJ2XNQC\\B ve B - 2026 - Comprehensive Comparative Study on Sign Language Translation Systems.pdf:application/pdf},
}

@inproceedings{chawla_openhands_2026,
	address = {Dubai, United Arab Emirates},
	title = {Openhands: {A} {Skeleton}-{Based} {Graph} {Convolutional} {Framework} for {Large}-{Scale} {Sign} {Language} {Recognition} and {LLM}-{Driven} {Sign} {Language} {Generation}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3195-0737-2},
	shorttitle = {Openhands},
	url = {https://ieeexplore.ieee.org/document/11565417/},
	doi = {10.1109/InterSys69825.2026.11565417},
	abstract = {Automatic sign language recognition (SLR) remains a critical challenge in computer vision, with applications in accessibility and human-computer interaction. This paper presents OpenHands, a modular skeleton-based framework for wordlevel sign language recognition that leverages MediaPipe Holistic to extract skeletal keypoints, constructs spatio-temporal graphs representing signer motion, and classifies signs using a decoupled GCN architecture enhanced with Dense Pose Correspondence (DPC) self-supervised pretraining. We evaluate on WLASL1000 (1,000 classes, 21,083 videos) and AUTSL100 (100 classes,∼3,000 videos), achieving 83.2\% Top-1 and 95.7\% Top-5 accuracy on WLASL1000, and 88.1\% Top-1 and 97.8\% Top-5 accuracy on AUTSL100. The framework provides reusable dataset pipelines, configuration-driven experimentation, and comprehensive tooling for training, inference, and visualization, enabling rapid prototyping across multiple sign language corpora. Our results demonstrate that skeleton-based GCNs with self-supervised pretraining achieve competitive performance while maintaining computational efficiency and modularity. We further extend OpenHands with a sign language generation (SLG) module that employs a transformer decoder conditioned on large language model (LLM) text embeddings to synthesise temporally coherent skeletal keypoint sequences from natural language input, enabling bidirectional text-to-sign translation within a unified framework and achieving a back-translation BLEU of 17.8 on PHOENIX-2014T.},
	language = {en},
	urldate = {2026-10-16},
	booktitle = {2026 {International} {Conference} on {Interactive} {Systems} \&amp; {Information} {Society} {Technologies} ({InterSys})},
	publisher = {IEEE},
	author = {Chawla, Naman and Nagpal, Krishna and Rajasekar, Elakkiya and Joseph, Angel Arul Jothi},
	month = may,
	year = {2026},
	pages = {1--8},
	file = {PDF:C\:\\Users\\senak\\Zotero\\storage\\RXSXDU6M\\Chawla vd. - 2026 - Openhands A Skeleton-Based Graph Convolutional Framework for Large-Scale Sign Language Recognition.pdf:application/pdf},
}

