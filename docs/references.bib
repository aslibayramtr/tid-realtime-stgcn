
@inproceedings{tran_anh_efficient_2025,
	address = {Khanh Hoa, Vietnam},
	title = {Efficient {Sign} {Language} {Recognition} with {Skeleton} {Data}: {A} {Study} of {Keypoint} {Selection}, {Pose} {Estimators}, and {GCN} {Models}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-5466-8},
	shorttitle = {Efficient {Sign} {Language} {Recognition} with {Skeleton} {Data}},
	url = {https://ieeexplore.ieee.org/document/11133720/},
	doi = {10.1109/MAPR67746.2025.11133720},
	abstract = {Sign language is the primary form of communication for deaf individuals; however, not everyone understands it. Sign language is a complex and dynamic communication system that utilizes hand gestures, body postures, and facial expressions to convey information. Therefore, a Sign Language Recognition (SLR) system can help break down communication barriers. In this work, we focus on effectively recognizing sign language using human skeleton data, where each component of the SLR system is carefully examined by studying and evaluating various methods. Firstly, we investigate the impact of different pose estimators on recognition performance. Secondly, a keypoint selection strategy is proposed to extract informative keypoints speciﬁcally designed for sign language recognition tasks. Moreover, we assess the role of Graph Convolutional Network (GCN) architectures for this task. In this work, we investigated two advanced GCN architectures, ST-GCN++ and CTR-GCN, to train the model using the selected keypoints. Additionally, label smoothing based on text information is exploited to improve the training process. Our proposal achieved promising results on the WLASL benchmark, achieving an accuracy of 56.46\% on WLASL2000, surpassing recent studies that rely solely on skeleton input.},
	language = {en},
	urldate = {2026-10-16},
	booktitle = {2025 {International} {Conference} on {Multimedia} {Analysis} and {Pattern} {Recognition} ({MAPR})},
	publisher = {IEEE},
	author = {Tran Anh, Vu Ho and Le Duc, Quan and Nguyen, Thi-Oanh},
	month = aug,
	year = {2025},
	pages = {1--6},
	file = {PDF:C\:\\Users\\senak\\Zotero\\storage\\NVI9LHB9\\Tran Anh vd. - 2025 - Efficient Sign Language Recognition with Skeleton Data A Study of Keypoint Selection, Pose Estimato.pdf:application/pdf},
}

@inproceedings{rastogi_real-time_2025,
	address = {Gwalior, India},
	title = {Real-{Time} {American} {Sign} {Language} to {Text} and {Speech} {Conversion} {Using} {Keypoint}-{Based} {Hand} {Gesture} {Recognition}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-5349-4},
	url = {https://ieeexplore.ieee.org/document/11350343/},
	doi = {10.1109/INSPECT67393.2025.11350343},
	abstract = {Effective communication between hearing-impaired individuals and the general population remains a challenge due to the unfamiliarity with sign language. To bridge this gap, we propose a real-time American Sign Language (ASL) recognition system that translates static hand gestures into text and speech. Using a standard laptop webcam, the system captures gestures, processes them via MediaPipe to extract 21 keypoints per hand, and classifies them using a lightweight TensorFlow Lite model. Recognized gestures are displayed in a user-friendly interface and converted to speech using a text-to-speech engine. Usability features like automatic word spacing after 5 seconds of inactivity and backspace correction enhance the user experience. The system demonstrates reliable performance in real-time without requiring specialized hardware or controlled environments. Its accessible design, efficiency, and real-time capabilities make it a practical tool for inclusive communication with the deaf and hard-of-hearing community.},
	language = {en},
	urldate = {2026-10-16},
	booktitle = {2025 {IEEE} {International} {Conference} on {Intelligent} {Signal} {Processing} and {Effective} {Communication} {Technologies} ({INSPECT})},
	publisher = {IEEE},
	author = {Rastogi, Kartikay and Patel, Karm and Garg, Kamal K. and Thakur, Gunjan},
	month = nov,
	year = {2025},
	pages = {1--6},
	file = {PDF:C\:\\Users\\senak\\Zotero\\storage\\RZHTEYZH\\Rastogi vd. - 2025 - Real-Time American Sign Language to Text and Speech Conversion Using Keypoint-Based Hand Gesture Rec.pdf:application/pdf},
}

