@inproceedings{dhrubo_bridging_2025,
	address = {New York, NY, USA},
	series = {{ICCA} '24},
	title = {Bridging {Worlds}: {Enhancing} {Low}-{Resources} {Sign} {Language} {Recognition} and {Seamless} {BdSL}-to-{Bengali} {Conversion} with {Sequential} {LSTM} {Innovation}},
